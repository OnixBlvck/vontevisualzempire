{
  "version": 1,
  "sdk_version": "2.0.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ckwsyqlczzufhrvvrbvz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "the-onixblvck-visions",
      "version": "0.1.0",
      "title": "The OnixBlvck Visions"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List the three VonteVisualz businesses (InkNior tattoo, Onyx Blvck music, FastCutEdits design) with their services and pricing notes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_portfolio",
        "title": "List portfolio work",
        "description": "List published VonteVisualz portfolio pieces (flyers, cover art, logos, video stills) with their brand and category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "brand": {
              "description": "Optional brand filter.",
              "type": "string",
              "enum": [
                "InkNior",
                "Onyx Blvck",
                "FastCutEdits"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_booking_request",
        "title": "Create booking request",
        "description": "Submit a booking request to VonteVisualz for InkNior (tattoo), Onyx Blvck (music) or FastCutEdits (design). Saved privately for the signed-in person.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "business": {
              "type": "string",
              "enum": [
                "inknior",
                "onyxblvck",
                "fastcutedits"
              ],
              "description": "Which business the request is for."
            },
            "full_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Name of the person booking."
            },
            "contact_email": {
              "type": "string",
              "maxLength": 160,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "description": "Reply-to email address."
            },
            "details": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "What the project or session is."
            },
            "preferred_date": {
              "description": "Optional preferred date, YYYY-MM-DD.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "business",
            "full_name",
            "contact_email",
            "details"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_booking_requests",
        "title": "List my booking requests",
        "description": "List the booking requests belonging to the signed-in person, newest first, with status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
