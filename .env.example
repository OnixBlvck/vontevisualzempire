# Copy to .env locally. Never commit real .env files or secrets.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_URL=https://your-project.supabase.co

# Server-only secrets — never expose these to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_key
SQUARE_ACCESS_TOKEN=replace_with_square_access_token
SQUARE_LOCATION_ID=replace_with_square_location_id
SQUARE_ENVIRONMENT=sandbox
LOVABLE_API_KEY=replace_with_lovable_api_key
WHATSAPP_API_KEY=replace_with_whatsapp_connection_key
